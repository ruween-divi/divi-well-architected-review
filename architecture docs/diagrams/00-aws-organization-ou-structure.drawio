        </mxCell>
        <mxCell id="stgtxt" value="&lt;b&gt;Region ap-southeast-2 (us-east-1: TF state, GuardKite;&lt;/b&gt;&lt;br&gt;  ap-southeast-1: 1 Lambda)&lt;br&gt;3 public /24 (10.20.1–3.0) + 3 private /24 (10.20.4–6.0)&lt;br&gt;AZs 2a/2b/2c · IGW · 3 NAT instances (t3.nano)&lt;br&gt;VGW vgw-0dcd38adec9339642 → VPN → Nocelle&lt;br&gt;  192.168.0.0/24 (static route)&lt;br&gt;VPC peering pcx-011e305428e123226 ↔ 10.40.0.0/16&lt;br&gt;  (account 156358246875)&lt;br&gt;No VPC endpoints · no flow logs&lt;br&gt;Default VPC 172.31.0.0/16 unused (vpc-069f67711034e5621)&lt;br&gt;&lt;br&gt;Workload: ECS Fargate (cluster divi-stg, 7 services),&lt;br&gt;21 Lambdas, RDS, MSK, ALB, 7 Amplify apps" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fontColor=#232F3E;strokeColor=#C5CCD3;fillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="stgacct">
