        <mxCell id="mgmtnet" value="&lt;b&gt;Network: default VPCs only (172.31.0.0/16), no workloads&lt;/b&gt;&lt;br&gt;ap-southeast-2 vpc-07a7ff37cb5989c72 · us-east-1 vpc-0a081c601f65d8290&lt;br&gt;Member accounts carry OrganizationAccountAccessRole trusting this account" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;fontColor=#232F3E;strokeColor=#C5CCD3;fillColor=#FFFFFF;rounded=1;arcSize=4;" vertex="1" parent="mgmt">
